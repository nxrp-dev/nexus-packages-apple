dialect "nxpackage.Language.nxscript";

RepositoryIndex ApplePackages {
    LocalPackage UniversalInterfaces {
        Id: "NXRP.Apple.UniversalInterfaces";
        Descriptor: "univint/Package.nxscript";
        Description: "Universal Apple C framework interfaces.";
    }
    LocalPackage CocoaInterfaces {
        Id: "NXRP.Apple.CocoaInterfaces";
        Descriptor: "cocoaint/Package.nxscript";
        Description: "macOS Cocoa Objective-C interfaces.";
    }
    LocalPackage AppleLocale {
        Id: "NXRP.Apple.AppleLocale";
        Descriptor: "iosxlocale/Package.nxscript";
        Description: "Apple locale and wide-string support.";
    }
}
