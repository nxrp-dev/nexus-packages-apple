dialect "../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../projects/nxbuild/Projects.nxscript";

Project AppleLocale {
    Id: "NXRP.Apple.AppleLocale";
    RootDirectory: "../../..";
    Author: "Yury Sidorov and Jonas Maebe";
    Description: "Core Foundation locale settings and wide-string support.";
    License: "LGPL-2.1-only WITH Independent-modules-exception";
    Requires: [@Projects.UniversalInterfaces];
    Publishes Directories {
        Sources: ["packages/nexus-packages-apple/iosxlocale/src"];
        Headers: ["packages/nexus-packages-apple/iosxlocale/src"];
    }
}
