dialect "../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../projects/nxbuild/Projects.nxscript";
module "../Apple.Environment.nxscript";

Project AppleLocale TargetCPU[x86_64, aarch64] TargetOS[darwin, iphonesim, ios] {
    Id: "NXRP.Apple.AppleLocale.Units";
    Publishes Directories { Sources: [@AppleLocale.OutputRoot]; }
    Requires: [@Projects.AppleRTL, @Projects.AppleLocale, @Projects.UniversalInterfaces];
    RootDirectory: "../../..";
    SourceRoot: "packages/nexus-packages-apple/iosxlocale";
    OutputRoot: "../../worktree/nexus/nxbuild-apple/" + @Apple.Name + "/iosxlocale" + "/" + $BuildConfiguration;

    FPC Units {
        CompilerPath: @Apple.CompilerPath;
        BuildKind: Unit;
        SourceFiles: [
            @AppleLocale.SourceRoot + "/src/iosxlocale.pas",
            @AppleLocale.SourceRoot + "/src/iosxwstr.pas"
        ];
        OutputPath: @AppleLocale.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Target Platform { OperatingSystem: @Apple.OS; }
        Assembler Native { OutputFormat: "clang"; }
        Definitions Symbols { Defines: []; }
        Files Paths {
            CompilerUtilitiesPath: @Apple.CompilerUtilitiesPath;
            UnitPaths: [
                @AppleLocale.OutputRoot,
                "../../worktree/nexus/nxbuild-apple/" + @Apple.Name + "/univint/" + $BuildConfiguration
            ];
            IncludePaths: [];
        }
    }
}
