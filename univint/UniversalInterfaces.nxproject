dialect "../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../projects/nxbuild/Projects.nxscript";
module "../Apple.Environment.nxscript";

Project UniversalInterfaces TargetCPU[x86_64, aarch64] TargetOS[darwin, iphonesim, ios] {
    Id: "NXRP.Apple.UniversalInterfaces.Units";
    Publishes Directories { Sources: [@UniversalInterfaces.OutputRoot]; }
    Requires: [@Projects.UniversalInterfaces];
    RootDirectory: "../../..";
    SourceRoot: "packages/nexus-packages-apple/univint";
    OutputRoot: "../../worktree/nexus/nxbuild-apple/" + @Apple.Name + "/univint";

    FPC Units {
        CompilerPath: @Apple.CompilerPath;
        BuildKind: Unit;
        SourceFiles: [
            @UniversalInterfaces.SourceRoot + "/src/MacOS.pas",
            @UniversalInterfaces.SourceRoot + "/src/MacOSAll.pas"
        ];
        OutputPath: @UniversalInterfaces.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: MacPas; }
        Target Platform { OperatingSystem: @Apple.OS; }
        Assembler Native { OutputFormat: "clang"; }
        Definitions Symbols { Defines: []; }
        Files Paths {
            CompilerUtilitiesPath: @Apple.CompilerUtilitiesPath;
            UnitPaths: [
                @Apple.RTLPath,
                @UniversalInterfaces.OutputRoot,
                "output/nxbuild-apple/" + @Apple.Name + "/univint"
            ];
            IncludePaths: [];
        }
    }
}
